NODE_ENV=development
PORT=4000

# MongoDB Atlas or local MongoDB
MONGODB_URI=mongodb://127.0.0.1:27017/yaqeen

# Comma-separated list of allowed frontend origins
CORS_ORIGIN=http://localhost:5173

# Use long random strings in production
JWT_ACCESS_SECRET=change-me-to-a-long-random-access-secret
JWT_REFRESH_SECRET=change-me-to-a-long-random-refresh-secret

LOG_LEVEL=info

# Store defaults
FREE_DELIVERY_THRESHOLD=2000
DEFAULT_DELIVERY_CHARGE=80
BKASH_MERCHANT_NUMBER=01XXXXXXXXX

# Initial admin created by `npm run seed -w @yaqeen/api`
ADMIN_NAME=Yaqeen Admin
ADMIN_EMAIL=admin@yaqeen.local
ADMIN_PASSWORD=ChangeMe123!

# WhatsApp seller alerts: disabled | cloud | ultramsg
WHATSAPP_PROVIDER=disabled
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_SELLER_NUMBER=8801799573916
WHATSAPP_TEMPLATE_NAME=new_order_alert
WHATSAPP_ULTRAMSG_INSTANCE_ID=
WHATSAPP_ULTRAMSG_TOKEN=

# Email seller alerts: disabled | resend | smtp
EMAIL_PROVIDER=disabled
RESEND_API_KEY=
EMAIL_FROM=Yaqeen <orders@example.com>
SELLER_ALERT_EMAILS=seller@example.com
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=

# Cloudinary image uploads
CLOUDINARY_CLOUD_NAME=dcdmktxtz
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
