NODE_ENV=development
PORT=4000

# Local development database (used when NODE_ENV is not production)
MONGODB_URI_LOCAL=mongodb://127.0.0.1:27017/anando_deal

# Production/online database (used only when NODE_ENV=production; set this in hosting)
# Example: MONGODB_URI=mongodb+srv://user:password@cluster.mongodb.net/ecommerce_store

# Comma-separated list of allowed frontend origins
CORS_ORIGIN=http://localhost:5173

# Use long random strings in production
JWT_ACCESS_SECRET=change-me-to-a-long-random-access-secret
JWT_REFRESH_SECRET=change-me-to-a-long-random-refresh-secret

LOG_LEVEL=info

# Store defaults
FREE_DELIVERY_THRESHOLD=2000
DEFAULT_DELIVERY_CHARGE=80
BKASH_MERCHANT_NUMBER=01XXXXXXXXX
NAGAD_MERCHANT_NUMBER=
ROCKET_MERCHANT_NUMBER=

# Initial admin created by `npm run seed -w @anando-deal/api`
ADMIN_NAME=Anando Deal Admin
ADMIN_EMAIL=admin@anandodeal.local
ADMIN_PASSWORD=ChangeMe123!

# WhatsApp seller alerts: disabled | cloud | ultramsg
WHATSAPP_PROVIDER=disabled
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_SELLER_NUMBER=+880 1770-937260
WHATSAPP_TEMPLATE_NAME=new_order_alert
WHATSAPP_ULTRAMSG_INSTANCE_ID=
WHATSAPP_ULTRAMSG_TOKEN=

# Email seller alerts and support mail: disabled | resend | smtp
# Support messages go to the supportEmail saved in admin Settings (default rabuofficial007@gmail.com, then SELLER_ALERT_EMAILS).
# EMAIL_FROM is also used as the reply-to address for admin support replies.
EMAIL_PROVIDER=disabled
RESEND_API_KEY=
EMAIL_FROM=Anando Deal <orders@example.com>
SELLER_ALERT_EMAILS=seller@example.com
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=

# Cloudinary image uploads
CLOUDINARY_CLOUD_NAME=dcdmktxtz
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
